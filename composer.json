{
  "require": {
    "phpoffice/phpspreadsheet": "^1.24",
    "psr/simple-cache": "^2.0"
  },

  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },

  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },

  "config": {
    "allow-plugins": {
      "composer/audit": false
    },
    "audit": {
      "block-insecure": false
    }
  }
}
